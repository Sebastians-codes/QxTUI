<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- NuGet packaging -->
    <PackageId>QxTui</PackageId>
    <Version>0.1.7</Version>
    <Authors>pmp</Authors>
    <Description>A terminal UI framework for .NET with fine-grained reactivity and damage isolation: an animating component re-renders only its own cells, declarative animations run on one global clock, the zero-alloc hot path renders at 200fps-class in pure C#, and layout is flexbox from day one.</Description>
    <PackageTags>terminal;tui;ui;console;ansi;reactive;flexbox;framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://codeberg.org/pmp/QxTUI</PackageProjectUrl>
    <RepositoryUrl>https://codeberg.org/pmp/QxTUI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QxTui.Tests" />
  </ItemGroup>

</Project>
